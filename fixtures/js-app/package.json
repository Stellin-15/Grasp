{
  "name": "js-app",
  "version": "1.2.0",
  "description": "Fixture: a small Express + React app.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "js-app": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
